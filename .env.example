# Never put real values in this file — it is committed to version control.
# Copy to .env and fill in real values locally.
#
# LOCAL DEV (CONSTRAINT-20, lifted 2026-10-12): .env holds the LOCAL Supabase
# stack only — run `npx supabase start`, then use its API URL, publishable key
# and DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres.
# Never put production values in any env file on a dev machine; prod's values
# live only in Vercel. db:seed / db:wipe refuse non-localhost URLs.

# Supabase — find these in your Supabase project settings > API
#
# The `service_role` key is deliberately NOT listed here. No code reads it, and
# it bypasses every RLS policy. Removed 2026-08-12 (@security T84-L02) — do not
# add it back without a task that genuinely needs admin-level DB access.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Updated 2026-08-16: this now holds a publishable key (`sb_publishable_...`),
# not a legacy JWT anon key. The variable name is kept so no code has to change
# — @supabase/ssr passes the string through without inspecting it. Supabase is
# retiring the legacy anon/service_role pair at the end of 2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Database — from the "Connect" dialog in the Supabase dashboard top bar.
# Use the SESSION-mode pooler (port 5432) — the "Session pooler" tab, host
# aws-0-[region].pooler.supabase.com, username postgres.[project-ref].
#
# Do NOT use the "Direct connection" string (host db.[project-ref].supabase.co,
# username plain `postgres`). That host is IPv6-only and Vercel's runtime is
# IPv4-only, so it fails as `getaddrinfo ENOTFOUND` before auth is ever
# attempted. It took prod down on 2026-08-16. Note the tell: ENOTFOUND means
# wrong string, not wrong password. Swapping only the hostname is not enough —
# the username differs too.
#
# Do NOT switch to the transaction pooler (port 6543) without retesting first.
# It is normally the correct serverless mode, but since 2026-08-02 it has been
# losing/misrouting query responses on this project and hangs every
# authenticated page (see docs/architecture.md → Database connection, FB-20).
# Session mode caps total clients at the project's pool_size, which is why
# db/index.ts holds max 2 connections per instance — do not raise it casually.
DATABASE_URL=your_database_connection_string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — internal Supabase Auth email. Internal only — never shown in UI.
# Each environment signs in as whichever user its own ADMIN_EMAIL names
# (CONSTRAINT-04). Since the 2026-08-02 rotation there are two users:
#   - production: a private email, set ONLY in the Vercel dashboard. Never
#     write it in this file, in source, or in any committed doc.
#   - local/QA:   the older, publicly-known email, set in your local .env.
# Treat the email as identifying, not secret — the password is the only real
# secret, and it belongs in gitignored files only.
ADMIN_EMAIL=

# Gmail IMAP — the email PO ingestion inbox (Feature 16).
#
# This MUST be a different Google account from ADMIN_EMAIL above. ADMIN_EMAIL is
# a live Supabase Auth credential (CONSTRAINT-04), not a spare mailbox: pointing
# ingestion at it would stage this app's own sign-in mail as purchase orders.
# `readGmailImapConfig` in lib/ingest/gmail.ts refuses to start when the two
# match, compared case-insensitively.
#
# The app password is a 16-character credential Google issues per application.
# It requires 2FA enabled on that account AND IMAP turned on in Gmail settings
# (Settings > Forwarding and POP/IMAP). It is a real secret — it belongs in
# gitignored .env and in the Vercel dashboard, never in this file, in
# source, or in any committed doc. Google has been progressively restricting app
# passwords; see assumptions.md A-09 for the OAuth fallback if this stops working.
#
# Ingestion opens the inbox READ-ONLY and never touches the \Seen flag, so
# reading the mailbox in Gmail cannot affect what gets ingested.
GMAIL_IMAP_USER=your_ingestion_account@gmail.com
GMAIL_IMAP_APP_PASSWORD=your_16_character_gmail_app_password
GMAIL_IMAP_HOST=imap.gmail.com

# OpenRouter — PO extraction (Feature 16, Task 98; CONSTRAINT-31).
# The key is a real secret: .env and the Vercel dashboard only. Zero data
# retention is enforced twice — account-wide in OpenRouter settings, and by a
# per-request `zdr: true` hardcoded in lib/extraction/openrouter.ts. There is
# deliberately NO variable to turn ZDR off.
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional. Defaults to openai/gpt-4.1-mini. Swap models here, no code change.
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Supabase secret key (`sb_secret_…`) — Feature 16, Task 103 (FB-42, CONSTRAINT-38).
# The session-less ingestion worker and cron use it to upload and download PO
# documents in the `po-documents` bucket. It bypasses RLS. Exactly ONE file may
# read it — lib/storage/po-documents.ts — and a test fails the suite if any
# other source file names it. Never prefix it NEXT_PUBLIC_.
#   - local: `npx supabase status` → SECRET_KEY (the local stack's dev key)
#   - prod:  Supabase → Settings → API Keys → create a secret key; set it in
#            the Vercel dashboard only. Revocable on its own there.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Shared secret for POST /api/ingest/extract (Task 116). The cron, the manual
# trigger and the worker's self-chain send it; the route refuses without it.
# Generate a long random value (e.g. `openssl rand -hex 32`); Vercel only.
INGEST_TRIGGER_SECRET=your_ingest_trigger_secret

# Secret Vercel's cron sends to GET /api/ingest/run (Task 104; vercel.json).
# Vercel reads this exact name. Use a value different from INGEST_TRIGGER_SECRET
# (`openssl rand -hex 32`); Vercel only. Locally, any value lets you curl the GET.
CRON_SECRET=your_cron_secret

# This app's own origin (Task 104). Every secret-carrying internal call targets
# it, never the request's Host: the manual trigger, the run route's worker poke
# and the worker's self-chain. Required; those routes answer 500 without it.
# Local: http://localhost:3000. Vercel: set per environment (Production = the
# production URL; never share Production's value with Preview, LOW-T104-3).
INGEST_APP_ORIGIN=http://localhost:3000
