# Never put real values in this file — it is committed to version control.
# Copy to .env.local and fill in real values locally.

# Supabase — find these in your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database — PostgreSQL connection string from Supabase project settings > Database
# Format: postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres
DATABASE_URL=your_database_connection_string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — internal Supabase Auth email. Internal only — never shown in UI.
# Set to `admin@totetrack.app` in every environment; the value must match the
# email of the single Supabase Auth user you create during setup (CONSTRAINT-04).
ADMIN_EMAIL=
